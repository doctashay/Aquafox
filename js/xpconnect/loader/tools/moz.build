# Build-time tools for bytecode cache generation
#
# The jsc_compile tool is built as a host program (runs on build machine)
# to generate .jsc bytecode cache files during the build process.

# Build jsc_compile as a host program
HostProgram('jsc_compile')

HOST_SOURCES += [
    'jsc_compile.cpp',
]

HOST_CXXFLAGS += [
    '-I%s/js/src' % TOPSRCDIR,
]

# Link against static JS library
HOST_USE_LIBS += [
    'js_static',
]

# Required for NSS-free SHA-256 (we include our own implementation)
# No external library dependencies needed
